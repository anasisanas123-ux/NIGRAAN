# Copy to dashboard/.env (scripts/setup.ps1 does this).
MONGODB_URI=mongodb://127.0.0.1:27017/nigraan
PORT=3000
PYTHON_ENGINE_PORT=5001

# ---- Alert notifications ----
# Sound and pop-ups in the dashboard work without any setup.
# Event types: possible_weapon, possible_violent_activity, restricted_area_entry,
# extended_zone_dwell, rapid_movement, expired_visitor_seen, exam_phone, exam_looking_around,
# exam_left_seat, exam_too_close, or "all". Leave a list empty to turn that channel off.
# NOTIFY_SOUND_EVENTS=all
# NOTIFY_EMAIL_EVENTS=possible_weapon,possible_violent_activity,restricted_area_entry,expired_visitor_seen
# NOTIFY_SMS_EVENTS=possible_weapon,possible_violent_activity
# Minimum seconds between two emails/SMS for the same camera and alert type.
# NOTIFY_REPEAT_SECONDS=60

# Email (on when SMTP_HOST and ALERT_EMAIL_TO are set). Gmail example: create an
# App Password (Google Account > Security > App passwords) and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password
# ALERT_EMAIL_FROM=you@gmail.com
# ALERT_EMAIL_TO=guard1@example.com,guard2@example.com

# SMS through Twilio (on when all four are set). Numbers in +countrycode format.
# A Twilio trial account can only text numbers you have verified in Twilio.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM=+15551234567
# ALERT_SMS_TO=+923001234567
