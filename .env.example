# Copy to .env (scripts/setup.ps1 does this) and edit for your cameras.
# Camera A is the PC webcam (device 0, set in config.py).

# Optional second camera: an RTSP address, or leave empty for webcam only.
# Write special characters in the password URL-encoded (@ -> %40, # -> %23).
# Dahua / CP Plus example:
#   CAM_B_RTSP='rtsp://admin:PASSWORD@192.168.1.64:554/cam/realmonitor?channel=1&subtype=0'
# Hikvision example:
#   CAM_B_RTSP='rtsp://admin:PASSWORD@192.168.1.64:554/Streaming/Channels/101'
CAM_B_RTSP=

# 0 = show video only in the dashboard; 1 = also open OpenCV windows.
SHOW_DESKTOP_WINDOWS=0
